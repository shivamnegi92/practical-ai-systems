# Offline is the default; no model access is needed for tests or baselines.
# For an optional local Ollama provider:
# PAS_LLM=ollama
# PAS_MODEL=llama3.2:3b
# OLLAMA_HOST=http://localhost:11434

# For an optional OpenAI-compatible endpoint:
# PAS_LLM=openai
# PAS_MODEL=your-model-name
# PAS_BASE_URL=https://your-approved-endpoint/v1
# PAS_API_KEY=replace-me
